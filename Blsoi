package com.scb.bsoi.base.delegate;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.apache.commons.lang.StringUtils;

import org.dozer.Mapper;
import com.scb.bsoi.accounts.helper.ProductMatcher;
import com.scb.bsoi.accounts.vo.ProductVO;
import com.scb.bsoi.common.bo.CommonBO;
import com.scb.bsoi.common.cache.PayeeCache;
import com.scb.bsoi.common.cache.ProductCache;
import com.scb.bsoi.common.cache.SessionCache;
import com.scb.bsoi.common.exception.BSOIException;
import com.scb.bsoi.context.BSOIContext;
import com.scb.nfs.base.util.config.PropertyEntryConfigurer;
import com.scb.nfs.base.util.dozer.DataMapperContainer;
import com.scb.nfs.base.util.logger.Logger;
import com.scb.ss.common.vo.accounts.Product;
import com.scb.ss.common.vo.customer.Customer;

public class BaseBSOIDelegate implements Serializable {

    private static final long serialVersionUID = 1L;

    protected Logger logger = Logger.getLogger(this.getClass());

    private PropertyEntryConfigurer configManager;

    private DataMapperContainer container;

    private SessionCache sessionCache;

    private ProductCache productCache;

    protected PayeeCache payeeCache;

    protected CommonBO commonBO;
    
    private Map<String, ProductMatcher> productMatchers = new HashMap<String, ProductMatcher>();

    public void setProductMatchers(Map<String, ProductMatcher> productMatchers) {
        this.productMatchers = productMatchers;
    }

    public String getProductKey(Product product){
        return productMatchers.get(BSOIContext.getCountry()).getProductKey(product);
    }
    
    public String getProductKey(ProductVO productVO){
        return productMatchers.get(BSOIContext.getCountry()).getProductKey(productVO);
    }
    
    public PayeeCache getPayeeCache() {
        return payeeCache;
    }

    public void setPayeeCache(PayeeCache payeeCache) {
        this.payeeCache = payeeCache;
    }

    public ProductCache getProductCache() {
        return productCache;
    }

    public void setProductCache(ProductCache productCache) {
        this.productCache = productCache;
    }

    public void setContainer(DataMapperContainer container) {
        this.container = container;
    }

    private Mapper getDataMapper() {
        return container.getMapper(BSOIContext.getCountry());
    }

    protected <T> T convert(Object source, Class<T> t) {
        Mapper mapper = getDataMapper();
        if(source == null){
            return null;
        }
        return mapper.map(source, t);
    }

    @SuppressWarnings("rawtypes")
    protected <T> List<T> convert(List sl, Class<T> t) {
        if (sl == null) {
            return null;
        }
        Mapper mapper = getDataMapper();
        List<T> tl = new ArrayList<T>();
        for (Object s : sl) {
            tl.add(mapper.map(s, t));
        }
        return tl;
    }

    public PropertyEntryConfigurer getConfigManager() {
        return configManager;
    }

    public void setConfigManager(PropertyEntryConfigurer configManager) {
        this.configManager = configManager;
    }

    public SessionCache getSessionCache() {
        return sessionCache;
    }

    public void setSessionCache(SessionCache sessionCache) {
        this.sessionCache = sessionCache;
    }

    protected Customer getCustomerFromSession() {
        logger.debug("getCustomerFromSession: customer is " + (sessionCache.getCustomer() == null ? "is null" : "is not null"));
        return sessionCache.getCustomer();
    }
    
    protected String getSasRequestIdFromSession() {
        logger.debug("getSasRequestIdFromSession: customer is " + ((sessionCache.getAuthorization()!=null?sessionCache.getAuthorization().getSasId():null) == null ? "is null" : "is not null"));
        return sessionCache.getAuthorization()!=null?sessionCache.getAuthorization().getSasId():null;
    }

    protected void invalidateProductCache() {
        productCache.invalidate();
    }
    
    protected void invalidatePayeeCache() {
        payeeCache.invalidate();
    }

    protected void setCustomerToSession(Customer customer) {
        sessionCache.setCustomer(customer);
        productCache.setCustomer(customer);
        payeeCache.setCustomer(customer);
    }

    public void setCommonBO(CommonBO commonBO) {
        this.commonBO = commonBO;
    }
    
    protected Map<String, String> getAccountDescMap() throws BSOIException{
        Map<String, String> acctDescMap = new HashMap<String, String>();
        List<Product> products = productCache.getProducts();
        for (Product product : products) {
            if(StringUtils.isBlank(product.getAccountNickName())){
                acctDescMap.put(getProductKey(product), product.getAccountDescription());   
            } else {
                acctDescMap.put(getProductKey(product), product.getAccountNickName());
            }
        }
        return acctDescMap;
    }
}
