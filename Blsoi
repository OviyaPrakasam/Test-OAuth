// Used for POST /tnc/prelogin
    public TnCResponse getTnCStatus(TnCRequest request) {
        TnCResponse response = new TnCResponse();
        try {
            CustomerVO reqVO = request.getCustomerVO();
            CustomerVO dbVO = customerBO.getCustomerInfo(reqVO); // fetch from DB
            String latestTcVersion = StringUtils.defaultIfBlank(request.getTcVersion(), "1.0");

            response.setTcVersion(latestTcVersion);
            response.setCustomerVO(dbVO);

            // Check T&C acceptance
            if (StringUtils.isNotBlank(latestTcVersion) &&
                (StringUtils.isBlank(dbVO.getIsTCAccepted())
                || "N".equalsIgnoreCase(dbVO.getIsTCAccepted())
                || !latestTcVersion.equalsIgnoreCase(dbVO.getTcVersionNo()))) {
                response.setTcFlagEnable("Y");
            } else {
                response.setTcFlagEnable("N");
            }

            response.setStatus("SUCCESS");

        } catch (Exception e) {
            logger.error("Error in getTnCStatus", e);
            response.setStatus("FAILURE");
        }
        return response;
    }



package com.scb.bsoi.tnc.delegate;

import com.scb.foa.bo.CustomerBO;
import com.scb.foa.vo.CustomerVO;
import com.scb.ss.common.context.tnc.request.TnCRequest;
import com.scb.ss.common.context.tnc.response.TnCResponse;
import com.scb.bsoi.base.delegate.BaseBSOIDelegate;

import java.util.Date;

public class TnCDelegate extends BaseBSOIDelegate {

    private CustomerBO customerBO;

    public TnCResponse updateTnCStatus(TnCRequest request) {
        CustomerVO customerVO = new CustomerVO();
        customerVO.setId(request.getCustomerId());
        customerVO.setIsTCAccepted(request.getIsTCAccepted());
        customerVO.setTcVersionNo(request.getTcVersionNo());
        customerVO.setTcAcceptedTime(request.getTcAcceptedTime() != null ? request.getTcAcceptedTime() : new Date());

        try {
            customerBO.updateTermsAndCondition(customerVO);
        } catch (Exception e) {
            logError("Error in updateTnCStatus", e);
            throw new RuntimeException("Unable to update T&C", e);
        }

        TnCResponse response = new TnCResponse();
        response.setCustomerId(customerVO.getId());
        response.setIsTCAccepted(customerVO.getIsTCAccepted());
        response.setTcVersionNo(customerVO.getTcVersionNo());
        response.setTcAcceptedTime(customerVO.getTcAcceptedTime());

        return response;
    }

    // Inject BO
    public void setCustomerBO(CustomerBO customerBO) {
        this.customerBO = customerBO;
    }
}


package com.scb.bsoi.tnc.endpoint.implementation;

import javax.ws.rs.Consumes;
import javax.ws.rs.POST;
import javax.ws.rs.Path;
import javax.ws.rs.Produces;
import javax.ws.rs.core.MediaType;

import com.scb.ss.common.context.tnc.request.TnCRequest;
import com.scb.ss.common.context.tnc.response.TnCResponse;
import com.scb.bsoi.tnc.delegate.TnCDelegate;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

@Component
@Path("/tnc")
public class TnCEndpointImpl {

    @Autowired
    private TnCDelegate tncDelegate;

    @POST
    @Path("/update")
    @Consumes(MediaType.APPLICATION_XML)
    @Produces(MediaType.APPLICATION_XML)
    public TnCResponse updateTermsAndConditions(TnCRequest request) {
        return tncDelegate.updateTnC(request);
    }

    @POST
    @Path("/get")
    @Consumes(MediaType.APPLICATION_XML)
    @Produces(MediaType.APPLICATION_XML)
    public TnCResponse getTermsAndConditions(TnCRequest request) {
        return tncDelegate.getTnC(request);
    }
}

