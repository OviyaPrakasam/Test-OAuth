CommonEndpointImpl.Java  

  @POST
    @Consumes(MediaType.APPLICATION_JSON)
    @Produces(MediaType.APPLICATION_JSON)
    @Path("/getTnC")
    public TNCVersionsResponse getTnCDetails(
            TNCVersionsRequest request) {
        TNCVersionsResponse response = new TNCVersionsResponse();
        try {
            CustomerVO customerVO = commonDelegate.getTnCData(request.getCustomerVO());
            response.setCustomerVO(customerVO);
        } catch (Exception e) {
            this.handleException(request, response, e);
        }
        return response;
    }
	

CommonDelegateImpl.java

    @Override
    public CustomerVO getTnCData(CustomerVO customerVO) throws BSOIException{
        Customer customer = this.convert(customerVO, Customer.class);
        customer = commonBO.getCustomerInfo(customer, this.getCustomerFromSession());
        customerVO = this.convert(customer, CustomerVO.class);
        return customerVO;
    }
	

CommonBOImpl.java

    @Override
    public Customer getCustomerInfo(Customer customer, Customer customerFromSession) throws BSOIException {
        return commonService.getCustomerVOfromDB(customer, customerFromSession);
    }
	

CommonServiceImpl.java

    @Override
    public Customer getCustomerVOfromDB(Customer customer, Customer customerfromSession) throws BSOIException {
        SSTNCVersionRequest request = makeRequest(SSTNCVersionRequest.class, customerfromSession);
        request.setCustomer(customer);
        SSTNCVersionResponse response = getSsCommonService().getCustomerVoFromDB(request);
        checkResponseStatus(response);
        return response.getCustomer();
    }
	
SSCommonImpl.java

	@Override
	public SSTNCVersionResponse getCustomerVoFromDB(SSTNCVersionRequest request) {
		ProcessContext context = createProcessContextWithUserContext(request, null);
		context.setValue(CommonServiceConstants.SS_TNC_VERSION, request.getCustomer());
		Response<Object> resp = executeProcess(request.getHeader(), context,
				ProcessConstants.PROCESS_GET_CUSTOMER_VO_FROM_DB);
		SSTNCVersionResponse response = new SSTNCVersionResponse();
		handleProcessResult(response.getResponse(), resp, context);
		response.setCustomer((Customer) resp.getValueObject());
		return response;
	}
	
SSGetTnCHandler.Java

    @SuppressWarnings({ "unchecked", "rawtypes" })
    @Override
    protected Response innerHandle(ProcessContext context) throws Exception {
        Customer customer =  (Customer) context.getValue(CommonServiceConstants.SS_TNC_VERSION);
        Customer customerFromSession = this.getCustomer(context);
        customer = customerService.getCustomerVOFromDB(context, customer, customerFromSession);
        context.setValue(CommonServiceConstants.SS_TNC_VERSION, customer);
        return getSuccessResponse(context, customer);
    }
	
