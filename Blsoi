package com.scb.ss.tnc.service.impl;

import com.scb.foa.customer.CustomerBO;
import com.scb.foa.customer.vo.CustomerVO;
import com.scb.ss.tnc.service.TnCService;
import com.scb.ss.context.tnc.TnCStatusRequest;
import com.scb.ss.context.tnc.TnCStatusResponse;

import java.util.Date;

public class TnCServiceImpl implements TnCService {

    private CustomerBO customerBO;

    public void setCustomerBO(CustomerBO customerBO) {
        this.customerBO = customerBO;
    }

    @Override
    public TnCStatusResponse checkTnCRequired(TnCStatusRequest request) {
        CustomerVO customerVO = new CustomerVO();
        customerVO.setCustomerId(request.getCustomerId());

        CustomerVO resultVO = customerBO.getCustomerInfo(customerVO);

        TnCStatusResponse response = new TnCStatusResponse();
        response.setCustomerId(resultVO.getCustomerId());
        response.setTncAccepted(resultVO.getIsTCAccepted());
        response.setTncVersion(resultVO.getTcVersionNo());
        response.setTncAcceptedTime(resultVO.getTcAcceptedTime());

        return response;
    }

    @Override
    public TnCStatusResponse updateTnCStatus(TnCStatusRequest request) {
        CustomerVO customerVO = new CustomerVO();
        customerVO.setCustomerId(request.getCustomerId());
        customerVO.setTcVersionNo(request.getTncVersion());
        customerVO.setIsTCAccepted("Y");
        customerVO.setTcAcceptedTime(new Date());

        customerBO.updateTermsAndCondition(customerVO);

        TnCStatusResponse response = new TnCStatusResponse();
        response.setCustomerId(customerVO.getCustomerId());
        response.setTncAccepted("Y");
        response.setTncVersion(customerVO.getTcVersionNo());
        response.setTncAcceptedTime(customerVO.getTcAcceptedTime());

        return response;
    }
}
