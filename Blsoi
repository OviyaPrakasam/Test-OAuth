package com.scb.bsoi.tnc.delegate;

import com.scb.bsoi.base.delegate.BaseBSOIDelegate;
import com.scb.common.context.request.TnCRequest;
import com.scb.common.context.response.TnCResponse;
import com.scb.vo.CustomerVO;
import com.scb.vo.TnCVO;

public class TnCDelegate extends BaseBSOIDelegate {

    public TnCVO getTnC(CustomerVO customerVO) {
        TnCRequest request = makeRequest(TnCRequest.class, customerVO);
        TnCResponse response = getSsTnCService().getTnC(request);
        checkResponseStatus(response);
        return response.getTncVO();
    }

    public void updateTnC(CustomerVO customerVO) {
        TnCRequest request = makeRequest(TnCRequest.class, customerVO);
        getSsTnCService().updateTnC(request);
        // Optional: check response status if required
    }
}


package com.scb.bsoi.tnc.endpoint.implementation;

import javax.ws.rs.*;
import javax.ws.rs.core.MediaType;

import com.scb.bsoi.tnc.delegate.TnCDelegate;
import com.scb.common.context.request.TnCRequest;
import com.scb.common.context.response.TnCResponse;
import com.scb.vo.CustomerVO;

@Path("/tnc")
public class TnCEndpoint {

    private TnCDelegate tncDelegate;

    public void setTncDelegate(TnCDelegate tncDelegate) {
        this.tncDelegate = tncDelegate;
    }

    @POST
    @Path("/get")
    @Consumes(MediaType.APPLICATION_XML)
    @Produces(MediaType.APPLICATION_XML)
    public TnCResponse getTnC(TnCRequest request) {
        CustomerVO customerVO = request.getCustomerVO();
        TnCResponse response = new TnCResponse();
        response.setTncVO(tncDelegate.getTnC(customerVO));
        return response;
    }

    @POST
    @Path("/update")
    @Consumes(MediaType.APPLICATION_XML)
    @Produces(MediaType.APPLICATION_XML)
    public TnCResponse updateTnC(TnCRequest request) {
        CustomerVO customerVO = request.getCustomerVO();
        tncDelegate.updateTnC(customerVO);
        TnCResponse response = new TnCResponse();
        response.setSuccess(true);
        return response;
    }
}
