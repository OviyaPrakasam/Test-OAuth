		ProcessContext context = createProcessContextWithUserContext(tncRequest, null);
		context.setValue(CommonServiceConstants.SS_SYS_PARAM, tncRequest.getCustomerVO());
		Response<Object> resp = executeProcess(tncRequest.getHeader(), context,
				ProcessConstants.PROCESS_GET_TNC_ACCEPTED_VERSIONS);
		TnCDataResponse response = new TnCDataResponse();
		handleProcessResult(response.getResponse(), resp, context);
		CustomerVO customerVO = response.getCustomerVO();
		response.setCustomerVO(customerVO);
