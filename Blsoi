package com.scb.ss.common.handler;

import com.scb.nfs.ibank.customer.vo.CustomerVO;
import com.scb.ss.exception.SSBusinessException;
import com.scb.ss.integration.service.customer.impl.HKCustomerService;
import com.scb.ss.process.Response;
import com.scb.ss.process.context.DataContext;
import com.scb.ss.process.context.ProcessContext;
import com.scb.ss.process.exception.ErrorCode;
import com.scb.ss.process.exception.ProcessException;
import com.solacesystems.jcsmp.protocol.smf.SSLSmfClient;

public class SSGetTnCHandler extends SSBaseHandler{

    HKCustomerService hkCustomerService;

    @Override
    protected Response innerHandle(ProcessContext context) throws SSBusinessException {
        CustomerVO inputVO = (CustomerVO) context.getValue("SS_SYS_PARAM");
        if (inputVO == null || inputVO.getId() == null) {
            throw new ProcessException(ErrorCode.PROCESS_NOT_FOUND);
        }
        CustomerVO newCustomerVO = hkCustomerService.getCustomerVOFromDB(inputVO);
        DataContext dataContext = new DataContext();
        dataContext.setValue("customerVO", newCustomerVO);
        return Response.getSuccessResponse(dataContext);
    }
}



