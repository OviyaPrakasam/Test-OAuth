	CustomerDAOImplementation:
	
	
	/**
	 *  Terms and Condition CR
	 * @param customerVO
	 * @throws DAOException
	 */
	public void updateUserTnCInfo(CustomerVO customerVO) throws DAOException {
		logger.debug("DAO-updateUserTnCInfo -Start --");
		try {
		Query query = currentSession().createQuery(
				"update UserVO "
						+ "set tcAcceptedTime = :tcAcceptedTime, tcVersionNo = :tcVersionNo, "
						+ "isTCAccepted = :isTCAccepted, "
						+ "updatedDate = :updatedDate, updatedBy = :updatedBy "
						+ "where id = :id");

		query.setParameter("tcAcceptedTime", customerVO.getTcAcceptedTime());
		query.setParameter("tcVersionNo", customerVO.getTcVersionNo());
		query.setParameter("isTCAccepted", customerVO.getIsTCAccepted());
		query.setParameter("updatedDate", new Date());
		query.setParameter("updatedBy", SysParamConstant.GBL_APP_NAME);
		query.setParameter("id", customerVO.getId());
		int i=query.executeUpdate();
		logger.debug("DAO-updateUserTnCInfo -end --"+i);
		}catch(Exception e ){
			logger.error("ERROR IN DAO-updateUserTnCInfo :" + e.getMessage());
		}
	}
	
	
	
