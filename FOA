	public static final String TC_JSON_VALUE = "tcJsonValue";
	public static final String TC_FLAG_ENABLE = "tcFlagEnable";
	public static final String TC_VERSION_VALUE = "termVersion";
	
	public ModelAndView doViewLanding(HttpServletRequest request, HttpServletResponse response) throws Exception {
	
		//code for HK T&C
	try {
		String termVersion = (String) request.getSession().getAttribute(TC_VERSION_VALUE);
		logger.debug("tcJsonValue==:{},getIsTCAccepted from customervo--"+termVersion+customerVO.getIsTCAccepted());
		logger.debug("doViewLanding-TC_FLAG_ENABLE---"+request.getSession().getAttribute(TC_FLAG_ENABLE));
		if(StringUtils.isNotBlank(termVersion) && StringUtils.isNotBlank(customerVO.getIsTCAccepted())) {
			if(customerVO.getIsTCAccepted().equalsIgnoreCase(CommonConstant.CONST_N)
				|| (!customerVO.getTcVersionNo().equalsIgnoreCase(termVersion))) {
				session.setAttribute(TC_FLAG_ENABLE,CommonConstant.CONST_Y);
				session.setAttribute("termVersion",termVersion);
			}else{
				session.setAttribute(TC_FLAG_ENABLE,CommonConstant.CONST_N);
			}
		}else{
			logger.debug("else block-tcJsonValue-->"+termVersion);
			session.setAttribute(TC_FLAG_ENABLE, CommonConstant.CONST_Y);
		}
	} catch (Exception ex){
		logger.error("T&C flag checks"+ex.getMessage());
	}
}

	/**
	 * Update User table post T&C accepted by user
	 * @param request
	 * @param response
	 * @return
	 * @throws Exception
	 */
	public ModelAndView doTnCUpdate(HttpServletRequest request, HttpServletResponse response) throws Exception{
		logger.debug("doTnCUpdate-termsVersion --"+request.getParameter("termVersion"));
		logger.debug("LandingPageController-doTnCUpdate-txnVersion-"+request.getSession().getAttribute("termVersion"));
		HttpSession session = request.getSession(false);
		CustomerVO customerVO = getCustomerVO();
		customerVO.setIsTCAccepted(CommonConstant.CONST_Y);
		customerVO.setTcAcceptedTime(new Date());
		customerVO.setTcVersionNo(StringUtils.isNotBlank((String) session.getAttribute("termVersion"))?session.getAttribute("termVersion").toString():CommonConstant.PAD_ZERO);
		customerBO.updateTermsAndCondition(customerVO);
		getCustomerInfo().setCustomerVO(customerVO);
		return doViewLanding(request, response);
	}
	

