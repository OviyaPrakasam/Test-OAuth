	@POST
	@Consumes(MediaType.APPLICATION_JSON)
	@Produces(MediaType.APPLICATION_JSON)
	@Path("/emailOtp")
	public EmailOtpResponse emailOtp(BaseBSOIRequest request) {
		EmailOtpResponse response = new EmailOtpResponse();
		try {
			EmailOTPVO emailOTPVO = securityDelegate.emailOtpGenerateOrValidate();
			if(emailOTPVO!=null) {
				if(StringUtils.isNotEmpty(emailOTPVO.getEmailAddress())) {
					response.setEmailAddress(emailOTPVO.getEmailAddress());
					response.setIsOTPRequired(BSOIContext.getIsOTPRequired());
				}
				if(null != request.getRequestHeader().getServiceContext()
						&& StringUtils.isNotEmpty(request.getRequestHeader().getServiceContext().getOtpToken())) {
					response.setAccessToken(emailOTPVO.getAccessToken());
				}
			}
		} catch (Exception e) {
			handleException(request, response, e);
		}
		return response;
	}

