	@POST
	@Consumes(MediaType.APPLICATION_JSON)
	@Produces(MediaType.APPLICATION_JSON)
	@Path("/login")
	public LoginResponse login(LoginRequest request) {
		LoginResponse response = new LoginResponse();
		LoginVO loginVO = null;
		try {
			getValidator(LoginRequest.class).validate(request);
			FunctionContext functionContext = request.getRequestHeader().getFunctionContext();
			if(functionContext != null){
				BSOIContext.setEnabledFunctions(functionContext.getEnabledFunctions());
			}
			loginVO = securityDelegate.login(this.getHttpServletRequest(), this.getHttpServletResponse(), 
					request.getLoginRequest());
			response.setLogin(loginVO);
		} catch (Exception e) {
			handleException(request, response, e);
		}
		return response;
	}

