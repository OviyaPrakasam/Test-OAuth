	@POST
	@Consumes(MediaType.APPLICATION_JSON)
	@Produces(MediaType.APPLICATION_JSON)
	@Path("/scpayRenewOTP")
	public BaseBSOIResponse scpayRenewOTP(BaseBSOIRequest request)
			throws BSOIException {
		BaseBSOIResponse response = new BaseBSOIResponse();
		try {
			/*
			 * renewOTP did not receive any parameters,just get paras from security cache
			 * because of the AOP,just call delegate need two params
			 * the reason why two paras -- when run paramProceedingJoinPoint.proceed(args);
			 * it will send the args(has two paras),if not set function which has two params will hit errors.
			 * */
			Object first_param = new Object();
			Object second_param = new Object();
			securityDelegate.renewOTP(first_param,second_param);
		} catch (Exception e) {
			handleException(request, response, e);
		}
		return response;
	}
	
